{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd app && npm ci",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/soundings/static/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/soundings/array/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/soundings/:path(.*)",
      "destination": "https://eu.i.posthog.com/:path"
    },
    { "source": "/flashcards/:topic", "destination": "/app-shell" },
    { "source": "/cheatsheet/:topic/:chapter", "destination": "/app-shell" },
    { "source": "/practice/:topic", "destination": "/app-shell" },
    { "source": "/practice/:topic/:chapter", "destination": "/app-shell" }
  ],
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "https://www.sachinmaurya.com",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/giscus/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://giscus.app" }
      ]
    }
  ]
}
